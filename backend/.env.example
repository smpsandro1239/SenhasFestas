PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=senhasfestas
# Ative SSL ao usar Postgres gerido (ex.: Neon). true/false
DB_SSL=false
# SEGREDO JWT OBRIGATÓRIO — sem valor por omissão.
JWT_SECRET=
# Credenciais do administrador inicial criado no boot (opcional).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3001
# Número de proxies de confiança à frente do backend (1 em produção atrás de proxy TLS)
TRUST_PROXY=1
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10