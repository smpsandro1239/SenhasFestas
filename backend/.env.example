# Environment Configuration for Development
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=senhas_festas

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-v3ry-s3cr3t-k3y-123456
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too-789abc

# Application Configuration
FRONTEND_URL=http://localhost:3001
API_VERSION=v1
MAX_UPLOAD_SIZE=10MB
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# QR Code Configuration
QR_CODE_SIZE=256
QR_CODE_MARGIN=1
QR_CODE_COLOR=000000
QR_CODE_BGCOLOR=FFFFFF

# Payment Methods (for future implementation)
ENABLE_MB_WAY=false
ENABLE_MULTIBANCO=false
ENABLE_CARD_PAYMENT=false

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_OFFLINE_MODE=false
ENABLE_AUDIT_LOG=true
ENABLE_RATE_LIMITING=true

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Email Configuration (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@senhasfestas.com