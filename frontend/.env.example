# A API é acedida same-origin através do rewrite /api/:path* (next.config.js).
# NEXT_PUBLIC_API_URL só é necessário server-side (destino do rewrite), não no client.

NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Base URL pública, usada pelo metadataBase (openGraph/twitter) para URLs absolutos.
# Se não estiver definida, cai para o alias Vercel em layout.tsx.
# IMPORTANTE: definir no projeto Vercel (senhas-festas) antes de configurar domínio próprio.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Segredo JWT partilhado com o backend (validação das sessões no middleware Edge)
JWT_SECRET=change-me