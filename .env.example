# Opcional — variáveis do docker compose (todas têm valores por omissão).
# Copie para .env na raiz e ajuste se necessário.

# Stack completa em Docker
NODE_ENV=development

# Base de dados (usada também pelo backend nativo — mantenha igual ao backend/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=senhasfestas

# Segredo JWT (produção: valor forte)
JWT_SECRET=super-secret-key-change-in-production

# Frontend (URL vistas pelo browser)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Rate limit do backend (pedidos por minuto por IP)
RATE_LIMIT_MAX=100