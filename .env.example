# Copie para .env na raiz e preencha os valores obrigatórios.

# Base de dados (usada também pelo backend nativo — mantenha igual ao backend/.env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere-me
POSTGRES_DB=senhasfestas

# SEGREDO JWT OBRIGATÓRIO — sem valor por omissão.
# Em produção gere um valor forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Frontend (URL vistas pelo browser; empacotadas em build-time)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Rate limit do backend (pedidos por minuto por IP)
RATE_LIMIT_MAX=100